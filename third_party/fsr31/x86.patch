diff --git a/sdk/tests/dx11_smoke.cpp b/sdk/tests/dx11_smoke.cpp
new file mode 100644
index 0000000..5053080
--- /dev/null
+++ b/sdk/tests/dx11_smoke.cpp
@@ -0,0 +1,102 @@
+#include <FidelityFX/host/backends/dx11/ffx_dx11.h>
+#include <FidelityFX/host/ffx_fsr3upscaler.h>
+#include <wrl/client.h>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <vector>
+
+using Microsoft::WRL::ComPtr;
+static void check(bool ok, const char* stage) {
+    if (!ok) { std::fprintf(stderr, "FAIL: %s\n", stage); std::exit(1); }
+}
+
+int main() {
+    std::printf("Pointer size: %zu bits\n", sizeof(void*) * 8);
+    ComPtr<ID3D11Device> device;
+    ComPtr<ID3D11DeviceContext> commands;
+    const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
+    HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0,
+        levels, 2, D3D11_SDK_VERSION, &device, nullptr, &commands);
+    check(SUCCEEDED(hr), "D3D11 hardware device");
+    check(device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_11_1, "FSR3 requires feature level 11.1 for UAV bindings");
+    for (unsigned count : {1u, 3u, 8u}) {
+        const size_t bytes = ffxGetScratchMemorySizeDX11(count);
+        void* scratch = std::calloc(1, bytes);
+        check(scratch != nullptr, "scratch allocation");
+        FfxInterface api = {};
+        check(ffxGetInterfaceDX11(&api, ffxGetDeviceDX11_Fsr31(device.Get()),
+            scratch, bytes, count) == FFX_OK, "backend interface");
+        std::vector<uint32_t> ids(count);
+        for (auto& id : ids) check(api.fpCreateBackendContext(&api, &id) == FFX_OK, "backend context create");
+        for (auto id : ids) check(api.fpDestroyBackendContext(&api, id) == FFX_OK, "backend context destroy");
+        std::free(scratch);
+    }
+    const size_t bytes = ffxGetScratchMemorySizeDX11(1);
+    void* scratch = std::calloc(1, bytes);
+    check(scratch != nullptr, "upscaler scratch");
+    FfxFsr3UpscalerContextDescription desc = {};
+    desc.maxRenderSize = {64, 64};
+    desc.maxUpscaleSize = {128, 128};
+    check(ffxGetInterfaceDX11(&desc.backendInterface, ffxGetDeviceDX11_Fsr31(device.Get()),
+        scratch, bytes, 1) == FFX_OK, "upscaler interface");
+    auto context = std::make_unique<FfxFsr3UpscalerContext>();
+    FfxErrorCode createError = ffxFsr3UpscalerContextCreate(context.get(), &desc);
+    std::printf("FSR3 create result: 0x%08x\n", static_cast<unsigned>(createError));
+    check(createError == FFX_OK, "FSR3 upscaler context");
+    std::puts("FSR3 upscaler context created");
+    auto texture = [&](unsigned size, DXGI_FORMAT format, unsigned bind, unsigned channels, float value) {
+        D3D11_TEXTURE2D_DESC td = {};
+        td.Width = td.Height = size; td.MipLevels = td.ArraySize = 1;
+        td.Format = format; td.SampleDesc.Count = 1; td.BindFlags = bind;
+        std::vector<float> pixels(size * size * channels, value);
+        D3D11_SUBRESOURCE_DATA data = {pixels.data(), size * channels * sizeof(float), 0};
+        ComPtr<ID3D11Texture2D> result;
+        check(SUCCEEDED(device->CreateTexture2D(&td, &data, &result)), "input/output texture");
+        return result;
+    };
+    const unsigned rw = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+    auto color = texture(64, DXGI_FORMAT_R32G32B32A32_FLOAT, D3D11_BIND_SHADER_RESOURCE, 4, 0.25f);
+    auto depth = texture(64, DXGI_FORMAT_R32_FLOAT, D3D11_BIND_SHADER_RESOURCE, 1, 0.5f);
+    auto motion = texture(64, DXGI_FORMAT_R32G32_FLOAT, D3D11_BIND_SHADER_RESOURCE, 2, 0.0f);
+    auto dilatedDepth = texture(64, DXGI_FORMAT_R32_FLOAT, rw, 1, 0.0f);
+    auto dilatedMotion = texture(64, DXGI_FORMAT_R32G32_FLOAT, rw, 2, 0.0f);
+    auto previousDepth = texture(64, DXGI_FORMAT_R32_UINT, rw, 1, 0.0f);
+    auto output = texture(128, DXGI_FORMAT_R32G32B32A32_FLOAT, rw, 4, 0.0f);
+    auto resource = [](ID3D11Texture2D* t) {
+        return ffxGetResourceDX11_Fsr31(t, GetFfxResourceDescriptionDX11(t), L"smoke");
+    };
+    FfxFsr3UpscalerDispatchDescription dispatch = {};
+    dispatch.commandList = ffxGetCommandListDX11(commands.Get());
+    dispatch.color = resource(color.Get()); dispatch.depth = resource(depth.Get());
+    dispatch.motionVectors = resource(motion.Get());
+    dispatch.dilatedDepth = resource(dilatedDepth.Get());
+    dispatch.dilatedMotionVectors = resource(dilatedMotion.Get());
+    dispatch.reconstructedPrevNearestDepth = resource(previousDepth.Get());
+    dispatch.output = resource(output.Get());
+    dispatch.renderSize = {64,64}; dispatch.upscaleSize = {128,128};
+    dispatch.motionVectorScale = {64.0f,64.0f};
+    dispatch.frameTimeDelta = 16.667f; dispatch.preExposure = 1.0f;
+    dispatch.cameraNear = 0.1f; dispatch.cameraFar = 1000.0f;
+    dispatch.cameraFovAngleVertical = 1.0f; dispatch.viewSpaceToMetersFactor = 1.0f;
+    for (unsigned frame = 0; frame < 3; ++frame) {
+        dispatch.reset = frame == 0;
+        check(ffxFsr3UpscalerContextDispatch(context.get(), &dispatch) == FFX_OK, "FSR3 dispatch");
+    }
+    D3D11_TEXTURE2D_DESC td;
+    output->GetDesc(&td); td.BindFlags = 0; td.Usage = D3D11_USAGE_STAGING;
+    td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Texture2D> readback;
+    check(SUCCEEDED(device->CreateTexture2D(&td, nullptr, &readback)), "readback texture");
+    commands->CopyResource(readback.Get(), output.Get());
+    D3D11_MAPPED_SUBRESOURCE mapped = {};
+    check(SUCCEEDED(commands->Map(readback.Get(), 0, D3D11_MAP_READ, 0, &mapped)), "GPU completion/readback");
+    auto pixel = reinterpret_cast<float*>(static_cast<unsigned char*>(mapped.pData) + 64 * mapped.RowPitch) + 64 * 4;
+    std::printf("Output center RGB: %.6f %.6f %.6f\n", pixel[0], pixel[1], pixel[2]);
+    for (unsigned c = 0; c < 3; ++c) check(std::isfinite(pixel[c]) && std::abs(pixel[c] - 0.25f) < 0.03f, "upscaled constant color");
+    commands->Unmap(readback.Get(), 0);
+    check(ffxFsr3UpscalerContextDestroy(context.get()) == FFX_OK, "upscaler destroy");
+    std::free(scratch);
+    std::puts("PASS: backend lifecycle and three FSR3 upscaler frames");
+}
