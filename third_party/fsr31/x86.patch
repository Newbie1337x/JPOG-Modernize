diff --git a/sdk/BuildFidelityFXDX11_x86.bat b/sdk/BuildFidelityFXDX11_x86.bat
new file mode 100644
index 0000000..68de075
--- /dev/null
+++ b/sdk/BuildFidelityFXDX11_x86.bat
@@ -0,0 +1,6 @@
+@echo off
+setlocal
+set "FFX_BUILD_ARCH=Win32"
+:: Build the backend and the FSR host APIs for 32-bit applications.
+call "%~dp0BuildFidelityFXDX11.bat" -DFFX_FSR3=ON -DFFX_FSR1=ON -DFFX_FSR2=ON -DFFX_FI=ON -DFFX_OF=ON %*
+exit /b %errorlevel%
